server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve at request time: the UI can start before the Service exists.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 3s;
    set $coin_backend coin-demo-backend.default.svc.cluster.local:3000;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }
    location /api/ {
        proxy_pass http://$coin_backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
